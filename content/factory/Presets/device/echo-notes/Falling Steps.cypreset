{
 "format": "cydaw-preset",
 "version": 1,
 "kind": "device",
 "target": "echo-notes",
 "name": "Falling Steps",
 "state": {
  "type": "echo-notes",
  "parameters": {
   "echonotes.time": 250.0,
   "echonotes.decay": 0.08,
   "echonotes.pitch": -1.0,
   "echonotes.sync": 3.0,
   "echonotes.repeats": 12.0
  }
 }
}