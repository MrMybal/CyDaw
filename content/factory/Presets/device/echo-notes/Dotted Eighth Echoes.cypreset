{
 "format": "cydaw-preset",
 "version": 1,
 "kind": "device",
 "target": "echo-notes",
 "name": "Dotted Eighth Echoes",
 "state": {
  "type": "echo-notes",
  "parameters": {
   "echonotes.time": 250.0,
   "echonotes.decay": 0.25,
   "echonotes.pitch": 0.0,
   "echonotes.sync": 8.0,
   "echonotes.repeats": 4.0
  }
 }
}