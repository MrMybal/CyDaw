{
 "format": "cydaw-preset",
 "version": 1,
 "kind": "device",
 "target": "echo-notes",
 "name": "Triplet Echoes",
 "state": {
  "type": "echo-notes",
  "parameters": {
   "echonotes.time": 250.0,
   "echonotes.decay": 0.2,
   "echonotes.pitch": 0.0,
   "echonotes.sync": 4.0,
   "echonotes.repeats": 5.0
  }
 }
}