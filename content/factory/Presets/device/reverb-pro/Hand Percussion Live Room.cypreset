   "revpro.mix": 0.2,
   "revpro.lowDecay": 0.8,
   "revpro.lowFrequency": 250.0,
   "revpro.midDecay": 1.0,
   "revpro.midFrequency": 1500.0,
   "revpro.highDecay": 0.7,
   "revpro.highFrequency": 6000.0,
   "revpro.lowCut": 150.0,
   "revpro.highCut": 15000.0,
   "revpro.ducking": 0.0,
   "revpro.duckRelease": 300.0,
   "revpro.freeze": 0.0,
