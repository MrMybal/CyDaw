{
  "format": "cydaw-processing",
  "version": 1,
  "kind": "audio",
  "name": "Remove Hum",
  "description": "Mains hum at 50 or 60 Hz (found) and its harmonics notched out.",
  "steps": [
    {
      "type": "hum",
      "enabled": true,
      "settings": {
        "fundamental": 0.0,
        "harmonics": 6.0,
        "width": 30.0
      }
    }
  ],
  "tail": {
    "allow": false,
    "thresholdDb": -60.0,
    "holdSeconds": 0.300000011920929,
    "maxSeconds": 10.0,
    "fadeMs": 30.0
  }
}