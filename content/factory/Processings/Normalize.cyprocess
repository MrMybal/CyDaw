{
  "format": "cydaw-processing",
  "version": 1,
  "kind": "audio",
  "name": "Normalize",
  "description": "The loudest peak brought to -1 dBFS.",
  "steps": [
    {
      "type": "normalise",
      "enabled": true,
      "settings": {
        "peak": -1.0
      }
    }
  ],
  "tail": {
    "allow": false,
    "thresholdDb": -60.0,
    "holdSeconds": 0.300000011920929,
    "maxSeconds": 10.0,
    "fadeMs": 30.0
  }
}