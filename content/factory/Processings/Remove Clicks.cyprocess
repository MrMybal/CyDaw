{
  "format": "cydaw-processing",
  "version": 1,
  "kind": "audio",
  "name": "Remove Clicks",
  "description": "Clicks, pops and dropouts redrawn from the sound around them.",
  "steps": [
    {
      "type": "declick",
      "enabled": true,
      "settings": {
        "maxClick": 2.0,
        "sensitivity": 0.5
      }
    }
  ],
  "tail": {
    "allow": false,
    "thresholdDb": -60.0,
    "holdSeconds": 0.300000011920929,
    "maxSeconds": 10.0,
    "fadeMs": 30.0
  }
}