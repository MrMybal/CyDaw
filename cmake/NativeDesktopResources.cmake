function(cydaw_native_desktop_resources target)
    enable_language(RC)
    set(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
    set(generated "${CMAKE_BINARY_DIR}/generated/branding")
    file(MAKE_DIRECTORY "${generated}")
    file(READ "${root}/resources/branding/cydaw-logo-512.png" logo HEX)
    string(LENGTH "${logo}" length)
    math(EXPR size "${length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," logo "${logo}")
    file(WRITE "${generated}/CyDAWBranding.h" "#pragma once\nnamespace cydaw::branding { extern const unsigned char cydawlogo512_png[]; extern const int cydawlogo512_pngSize; }\n")
    file(WRITE "${generated}/CyDAWBranding.cpp" "#include \"CyDAWBranding.h\"\nnamespace cydaw::branding { const unsigned char cydawlogo512_png[]={${logo}}; const int cydawlogo512_pngSize=${size}; }\n")
    set(CYDAW_RESOURCE_ICON "${root}/resources/branding/cydaw.ico")
    configure_file("${root}/resources/branding/NativeDesktop.rc.in" "${generated}/CyDAW.rc" @ONLY)
    target_sources(${target} PRIVATE "${generated}/CyDAWBranding.cpp" "${generated}/CyDAW.rc" "${root}/resources/branding/CyDAW.manifest")
    target_include_directories(${target} PRIVATE "${generated}")
    target_link_libraries(${target} PRIVATE comctl32 ole32 shell32 winmm)
endfunction()
