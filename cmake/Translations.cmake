# Original UTF-8 resource embedding, independent of a GUI framework.
set(cydaw_translations_dir "${CMAKE_CURRENT_BINARY_DIR}/generated/translations")
file(MAKE_DIRECTORY "${cydaw_translations_dir}")
set(cydaw_translation_source "#include \"CyDAWTranslations.h\"\nnamespace cydaw::translations {\n")
foreach(cydaw_language IN ITEMS en fr)
    set(cydaw_translation_path "${CMAKE_CURRENT_SOURCE_DIR}/resources/i18n/${cydaw_language}.json")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${cydaw_translation_path}")
    file(READ "${cydaw_translation_path}" cydaw_translation_hex HEX)
    string(REGEX REPLACE "(..)" "0x\\1," cydaw_translation_bytes "${cydaw_translation_hex}")
    string(REPEAT "0x[0-9a-f][0-9a-f]," 16 cydaw_translation_line)
    string(REGEX REPLACE "(${cydaw_translation_line})" "\\1\n" cydaw_translation_bytes "${cydaw_translation_bytes}")
    string(APPEND cydaw_translation_source "static const unsigned char ${cydaw_language}_data[] = {\n${cydaw_translation_bytes}0};\nconst char* const ${cydaw_language}_json=reinterpret_cast<const char*>(${cydaw_language}_data);\nconst int ${cydaw_language}_jsonSize=sizeof(${cydaw_language}_data)-1;\n")
endforeach()
string(APPEND cydaw_translation_source "}\n")
file(WRITE "${cydaw_translations_dir}/CyDAWTranslations.cpp" "${cydaw_translation_source}")
file(WRITE "${cydaw_translations_dir}/CyDAWTranslations.h" "#pragma once\nnamespace cydaw::translations {extern const char* const en_json;extern const int en_jsonSize;extern const char* const fr_json;extern const int fr_jsonSize;}\n")
add_library(CyDAWTranslations STATIC "${cydaw_translations_dir}/CyDAWTranslations.cpp")
target_compile_features(CyDAWTranslations PUBLIC cxx_std_20)
target_include_directories(CyDAWTranslations PUBLIC "${cydaw_translations_dir}")
set_target_properties(CyDAWTranslations PROPERTIES POSITION_INDEPENDENT_CODE ON)
if(MSVC)
    target_compile_options(CyDAWTranslations PRIVATE /utf-8)
endif()
