# Compile the existing, CyDAW-owned drawing algorithms against a small std::string
# value type. Authoring-only theme files and translation loading are excluded.
# No JUCE source directory is added to this project.
set(native_visual_dir "${CMAKE_CURRENT_BINARY_DIR}/native-visuals")
file(MAKE_DIRECTORY "${native_visual_dir}")
function(native_slice text begin end out)
    string(FIND "${text}" "${begin}" a)
    string(FIND "${text}" "${end}" b)
    if(a LESS 0 OR b LESS a)
        message(FATAL_ERROR "Shared UI source changed at ${begin}; update its portable adapter")
    endif()
    math(EXPR n "${b}-${a}")
    string(SUBSTRING "${text}" ${a} ${n} part)
    set(${out} "${part}" PARENT_SCOPE)
endfunction()
set(shared_dir "${CYDAW_SOURCE_ROOT}/src/v2")
file(GLOB panes "${shared_dir}/*Panes.inc")
set(files InstrumentPanels.h InstrumentPanels.cpp SynthLayouts.h SynthLayouts.cpp DeviceVisuals.h DeviceVisuals.cpp StudioEffectsView.h StudioEffectsView.cpp Widgets.h Widgets.cpp Theme.h SignalAnalysis.h SignalAnalysis.cpp Icons.h)
foreach(p IN LISTS panes)
    get_filename_component(name "${p}" NAME)
    list(APPEND files "${name}")
endforeach()
foreach(name IN LISTS files)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${shared_dir}/${name}")
    file(READ "${shared_dir}/${name}" content)
    if(name STREQUAL "Theme.h")
        native_slice("${content}" "// A colour theme:" "// Applies colours and sizes" metadata)
        string(REPLACE "${metadata}" "" content "${content}")
    elseif(name STREQUAL "Widgets.cpp")
        native_slice("${content}" "    const auto file = juce::File" "\njuce::String language()" loader)
        string(REPLACE "${loader}" "}\n" content "${content}")
        string(REPLACE "bool gFrench = true;" "bool gFrench = false;" content "${content}")
        string(REPLACE "gLanguage { \"fr\" }" "gLanguage { \"en\" }" content "${content}")
    endif()
    string(REPLACE "#include <juce_core/juce_core.h>" "#include \"PortableString.h\"" content "${content}")
    string(REPLACE "juce::" "cydaw::portable::" content "${content}")
    if(content MATCHES "#include [<\"]juce_")
        message(FATAL_ERROR "${name} introduced a JUCE include into the native renderer")
    endif()
    file(WRITE "${native_visual_dir}/${name}" "${content}")
endforeach()
file(READ "${shared_dir}/Theme.cpp" content)
native_slice("${content}" "namespace cydaw::v2::theme" "juce::File fontsFolder()" prefix)
native_slice("${content}" "const Palette& palette()" "const std::vector<Theme>&" access)
native_slice("${content}" "ImU32 alpha(" "void loadFonts()" helpers)
native_slice("${content}" "void apply(const float" "} // namespace cydaw::v2::theme" styles)
file(WRITE "${native_visual_dir}/Theme.cpp" "#include \"Theme.h\"\n#include <algorithm>\n#include <cmath>\n${prefix}\nvoid applyColours(ImGuiStyle&);\n}\n${access}\n${helpers}\nvoid loadFonts();\n${styles}\n} // namespace cydaw::v2::theme\n")
set(native_visual_sources "${native_visual_dir}/InstrumentPanels.cpp" "${native_visual_dir}/SynthLayouts.cpp" "${native_visual_dir}/DeviceVisuals.cpp" "${native_visual_dir}/StudioEffectsView.cpp" "${native_visual_dir}/Widgets.cpp" "${native_visual_dir}/Theme.cpp" "${native_visual_dir}/SignalAnalysis.cpp")
