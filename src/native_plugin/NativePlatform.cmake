set(imgui "${CYDAW_SOURCE_ROOT}/third_party/imgui")
set(native "${CYDAW_SOURCE_ROOT}/src/native_plugin")
if(WIN32)
    set(native_platform_sources "${native}/NativeEditorSurface.cpp" "${imgui}/backends/imgui_impl_win32.cpp" "${imgui}/backends/imgui_impl_dx11.cpp")
    set(native_platform_libraries d3d11 dxgi d3dcompiler dwmapi)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(pugl "${CYDAW_SOURCE_ROOT}/third_party/pugl")
    add_library(cydaw_pugl STATIC "${pugl}/src/common.c" "${pugl}/src/internal.c" "${pugl}/src/x11.c" "${pugl}/src/x11_gl.c")
    target_include_directories(cydaw_pugl PUBLIC "${pugl}/include" PRIVATE "${pugl}/src")
    target_compile_definitions(cydaw_pugl PRIVATE PUGL_STATIC PUGL_INTERNAL USE_XRANDR=0 USE_XSYNC=0 USE_XCURSOR=0)
    set_target_properties(cydaw_pugl PROPERTIES POSITION_INDEPENDENT_CODE ON)
    if(CYDAW_LINUX_SYSROOT)
        target_include_directories(cydaw_pugl PUBLIC "${CYDAW_LINUX_SYSROOT}/usr/include")
        target_link_directories(cydaw_pugl PUBLIC "${CYDAW_LINUX_SYSROOT}/usr/lib/x86_64-linux-gnu")
    endif()
    target_link_libraries(cydaw_pugl PUBLIC X11 GL dl pthread)
    set(native_platform_sources "${native}/NativeEditorPugl.cpp" "${imgui}/backends/imgui_impl_opengl3.cpp")
    set(native_platform_libraries cydaw_pugl)
else()
    message(FATAL_ERROR "Native plugin export supports Windows and Linux; macOS is deferred")
endif()
function(cydaw_native_platform target)
    target_sources(${target} PRIVATE ${native_platform_sources})
    target_link_libraries(${target} PRIVATE ${native_platform_libraries})
    if(MSVC)
        target_compile_options(${target} PRIVATE /utf-8 /EHsc)
    endif()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        target_compile_definitions(${target} PRIVATE PUGL_STATIC)
        set_target_properties(${target} PROPERTIES SKIP_BUILD_RPATH TRUE)
        if(CYDAW_EXPORT_FORMAT STREQUAL "CLAP")
            set(extraLicenses "$<TARGET_FILE_DIR:${target}>/${CYDAW_PRODUCT_NAME}.clap.Licenses")
        else()
            set(extraLicenses "$<TARGET_FILE_DIR:${target}>/Licenses")
        endif()
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E make_directory "${extraLicenses}"
            COMMAND ${CMAKE_COMMAND} -E copy_if_different "${CYDAW_SOURCE_ROOT}/third_party/pugl/COPYING" "${extraLicenses}/Pugl.txt")
        if(CYDAW_TOOLCHAIN_ROOT)
            add_custom_command(TARGET ${target} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
                "${CYDAW_TOOLCHAIN_ROOT}/zig/LICENSE" "${extraLicenses}/Zig-runtime.txt")
            # Zig's ELF linker can strip while linking; objcopy does not
            # implement rewriting every kind of shared ELF object.
            target_link_options(${target} PRIVATE -s)
            foreach(runtime libcxx libcxxabi libunwind)
                add_custom_command(TARGET ${target} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
                    "${CYDAW_TOOLCHAIN_ROOT}/zig/lib/${runtime}/LICENSE.TXT" "${extraLicenses}/${runtime}.txt")
            endforeach()
        endif()
    endif()
endfunction()
