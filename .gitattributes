# Large binary or generated content stored with Git LFS: the factory sound
# models, the example projects and their audio.
*.cysound filter=lfs diff=lfs merge=lfs -text
*.cydaw filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text

# Preserve upstream bytes: these sources carry recorded SHA-256 provenance.
third_party/asio-sdk/** -text -whitespace
third_party/portaudio-asio/** -text -whitespace

third_party/nlohmann/** -text -whitespace
